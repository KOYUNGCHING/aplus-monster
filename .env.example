# ─── Frontend public values ───────────────────────────────────────────────────
# Only VITE_ prefixed values are exposed to the browser bundle.
# Never add secrets with VITE_ prefix.

VITE_SUPABASE_URL=your-project-url
VITE_SUPABASE_ANON_KEY=your-public-anon-key

# ─── Backend secrets ──────────────────────────────────────────────────────────
# Set these in your serverless provider's secret manager.
# NEVER expose these to Vite or commit real values.

NVIDIA_API_KEY=replace-in-server-secret-manager
NVIDIA_BASE_URL=verify-current-provider-endpoint
NVIDIA_MODEL=verify-enabled-model-id
